# Public repository is opt-in. Local discs, binaries and generated translations stay local.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/LICENSE
!/NOTICE.md
!/CONTRIBUTING.md
!/ROADMAP.md
!/Cargo.toml
!/Cargo.lock
!/crates/
!/crates/**
!/specs/
!/specs/**
!/.github/
!/.github/**
!/scripts/
!/scripts/**
!/prompts/
!/prompts/**
!/docs/
!/docs/**
/docs/local/
/docs/prototype-tcrf-notes.md
# Legacy static translation entry point is local research only.
/scripts/native.ps1
/scripts/ghidra_analyze_retail.sh
/prompts/0[1-5]-*.md
/docs/toolchains.lock.json
**/__pycache__/
**/*.pyc
# These extensions have no place even in an otherwise public directory.
*.iso
*.bin
*.cue
*.elf
*.irx
*.afs
*.ps2
*.p2s
*.exe
*.dll
*.lib
*.zip
*.7z
*.log
